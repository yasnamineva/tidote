# Copy this file to .env.local and fill it in. .env.local is gitignored, and
# excluded from deploys — Vercel reads its own copy from
# Settings → Environment Variables.

# Supabase dashboard → Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The "publishable" key (older projects call it "anon public"). Meant to be
# public: on its own it can read nothing, because every table checks who asks.
# Settings -> API Keys. Older projects call this the anon public key, and
# NEXT_PUBLIC_SUPABASE_ANON_KEY is still read if that is what you have.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The "secret" key (older projects call it "service_role"). Bypasses every
# access rule in the database. Server-side only — it must never gain a
# NEXT_PUBLIC_ prefix, which is what keeps it out of the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Guards the daily keep-alive and the export endpoint
# so they cannot be called by anyone who guesses the URL.
CRON_SECRET=

# The demo account. Its password is printed on the public login page, so it is
# a label rather than a secret — but make it 12+ characters all the same.
# Unset both and the demo button disappears.
NEXT_PUBLIC_DEMO_EMAIL=demo@tidoteatelier.com
NEXT_PUBLIC_DEMO_PASSWORD=
