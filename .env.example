# Supabase — from the dashboard at Settings → API.
# Copy this file to .env.local and fill it in. .env.local is gitignored.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: bypasses every access rule in the database.
# Server-side only — it must never gain a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Guards the daily keep-alive and the export endpoint
# so they cannot be called by anyone who guesses the URL.
CRON_SECRET=
